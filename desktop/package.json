{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "description": "Electron desktop wrapper for DeepSeek Harness (dsh). Spawns the local `dsh web` host and loads its Web UI in a native window.",
  "main": "src/main.js",
  "author": "Yuan-lai-ru-ci",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/generate-icons.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.js",
    "verify:e2e": "node scripts/verify-e2e.js",
    "verify:titlebar": "electron scripts/verify-titlebar.js",
    "verify:packaged": "node scripts/verify-packaged-host.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon-512.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
